@model EventVenueBooking.ViewModels.AdminDashboardViewModel
@using System.Globalization

@{
    ViewBag.Title = "Dashboard";
    ViewBag.ActiveMenu = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var inv = CultureInfo.InvariantCulture;
    string[] fillClasses = { "fill-purple", "fill-green", "fill-orange" };

    // Chuỗi mảng JS cho Chart.js (số dùng InvariantCulture để luôn có dấu chấm thập phân)
    string statusLabelsJs = "[" + string.Join(",", Model.StatusCounts.Select(s => "'" + s.Name + "'")) + "]";
    string statusDataJs = "[" + string.Join(",", Model.StatusCounts.Select(s => s.Count.ToString(inv))) + "]";
    string statusColorsJs = "[" + string.Join(",", Model.StatusCounts.Select(s => "'" + s.Color + "'")) + "]";
    string revenueLabelsJs = "[" + string.Join(",", Model.RevenueLabels.Select(l => "'" + l + "'")) + "]";
    string venueSeriesJs = "[" + string.Join(",", Model.VenueCostSeries.Select(v => v.ToString("0", inv))) + "]";
    string addOnSeriesJs = "[" + string.Join(",", Model.AddOnCostSeries.Select(v => v.ToString("0", inv))) + "]";
}

<!-- Tải Chart.js để vẽ biểu đồ -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<style>
    /* RESET MÀU NỀN TRONG LAYOUT CHÍNH */
    .page-body {
        padding: 0 25px 25px 25px;
    }

    /* CARD CHUNG */
    .dash-card {
        background: #FFFFFF;
        border-radius: 16px;
        padding: 20px 24px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .card-title {
        font-size: 16px;
        font-weight: 700;
        color: #1C2A23;
    }

    .dropdown-btn {
        background: #F4F7FB;
        color: #5D7285;
        border: none;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
        cursor: default;
    }

    /* HÀNG TOP - 3 STATS CARDS */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 16px;
    }

    .stat-card-inner {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .icon-green {
        background: #EBF4EE;
        color: #184A3B;
    }

    .icon-orange {
        background: #FDF3E7;
        color: #F2A341;
    }

    .stat-info h5 {
        font-size: 13px;
        color: #738A7C;
        margin-bottom: 4px;
        font-weight: 500;
    }

    .stat-info h3 {
        font-size: 24px;
        color: #1C2A23;
        font-weight: 700;
    }

    /* NÚT EXPORT EXCEL */
    .btn-export {
        background: #184A3B; /* Màu xanh lá chủ đạo */
        color: #FFFFFF;
        border: none;
        padding: 10px 18px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(24, 74, 59, 0.15);
    }

        .btn-export:hover {
            opacity: 0.9;
            transform: translateY(-1px);
            color: #FFFFFF;
        }

    /* LƯỚI CHÍNH CỦA BẢNG ĐIỀU KHIỂN */
    .main-grid {
        display: grid;
        grid-template-columns: 1fr 1.8fr;
        gap: 20px;
    }

    /* KHU VỰC BÊN TRÁI: BOOKING STATUS (BIỂU ĐỒ TRÒN) */
    .chart-donut-container {
        position: relative;
        height: 220px;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 20px;
    }

    .donut-inner-text {
        position: absolute;
        text-align: center;
    }

        .donut-inner-text p {
            font-size: 12px;
            color: #738A7C;
            margin-bottom: 2px;
        }

        .donut-inner-text h4 {
            font-size: 22px;
            color: #1C2A23;
            font-weight: 700;
        }

    .status-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .status-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .status-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .status-color {
        width: 4px;
        height: 24px;
        border-radius: 4px;
    }

    .color-green {
        background: #184A3B;
    }

    .color-orange {
        background: #F7C17F;
    }

    .color-purple {
        background: #DCE0FA;
    }

    .status-text h6 {
        font-size: 13px;
        color: #738A7C;
        font-weight: 500;
    }

    .status-text h4 {
        font-size: 16px;
        color: #1C2A23;
        font-weight: 700;
    }

    .status-percent {
        background: #F4F7FB;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        color: #1C2A23;
    }

    /* KHU VỰC BÊN PHẢI */
    .right-grid {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .revenue-header-info {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 15px;
    }

    .revenue-total p {
        font-size: 13px;
        color: #738A7C;
        margin-bottom: 4px;
    }

    .revenue-total h3 {
        font-size: 24px;
        color: #1C2A23;
        font-weight: 700;
    }

    .legend-list {
        display: flex;
        gap: 16px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: #738A7C;
    }

    .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .chart-bar-container {
        height: 240px;
        width: 100%;
    }

    /* THANH NGANG - POPULAR EVENT TYPES */
    .event-type-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .event-row {
        display: grid;
        grid-template-columns: 130px 1fr 110px;
        align-items: center;
        gap: 15px;
    }

    .event-name {
        font-size: 14px;
        font-weight: 600;
        color: #738A7C;
    }

    .progress-bar-wrapper {
        background: #F4F7FB;
        height: 12px;
        border-radius: 10px;
        overflow: hidden;
        position: relative;
    }

    .progress-fill {
        height: 100%;
        border-radius: 10px;
        display: flex;
        align-items: center;
        padding-left: 8px;
        font-size: 10px;
        font-weight: 700;
    }

    .fill-purple {
        background: #DCE0FA;
        color: #184A3B;
    }

    .fill-green {
        background: #184A3B;
        color: #FFF;
    }

    .fill-orange {
        background: #F7C17F;
        color: #184A3B;
    }

    .event-count {
        font-size: 13px;
        font-weight: 600;
        color: #1C2A23;
        text-align: right;
    }
</style>

<!-- 1. HÀNG TOP - CARDS THỐNG KÊ -->
<div class="stats-grid">
    <div class="dash-card">
        <div class="stat-card-inner">
            <div class="stat-icon icon-orange"><i class='bx bx-calendar-event'></i></div>
            <div class="stat-info">
                <h5>Upcoming Events</h5>
                <h3>@Model.UpcomingEvents.ToString("N0")</h3>
            </div>
        </div>
    </div>
    <div class="dash-card">
        <div class="stat-card-inner">
            <div class="stat-icon icon-orange"><i class='bx bx-check-square'></i></div>
            <div class="stat-info">
                <h5>Total Bookings</h5>
                <h3>@Model.TotalBookings.ToString("N0")</h3>
            </div>
        </div>
    </div>
    <div class="dash-card">
        <div class="stat-card-inner">
            <div class="stat-icon icon-orange"><i class='bx bx-wallet'></i></div>
            <div class="stat-info">
                <h5>Total Revenue</h5>
                <h3>@Model.TotalRevenue.ToString("N0") VNĐ</h3>
            </div>
        </div>
    </div>
</div>

<!-- NÚT EXPORT EXCEL NẰM Ở GIỮA 3 BOX TRÊN VÀ PHẦN DASHBOARD BÊN DƯỚI -->
<div style="display: flex; justify-content: flex-end; margin-bottom: 20px;">
    <a href="@Url.Action("ExportRevenueExcel", "Dashboard")" class="btn-export">
        <i class='bx bx-file' style="font-size: 16px;"></i> Export Excel
    </a>
</div>

<!-- 2. HÀNG CHÍNH - LƯỚI 2 CỘT -->
<div class="main-grid">

    <!-- CỘT TRÁI: BOOKING STATUS -->
    <div class="dash-card">
        <div class="card-header">
            <div class="card-title">Booking Status</div>
            <span class="dropdown-btn">All time</span>
        </div>

        <div class="chart-donut-container">
            <canvas id="statusChart"></canvas>
            <div class="donut-inner-text">
                <p>Total Bookings</p>
                <h4>@Model.TotalBookings.ToString("N0")</h4>
            </div>
        </div>

        <div class="status-list">
            @foreach (var s in Model.StatusCounts)
            {
                <div class="status-item">
                    <div class="status-left">
                        <div class="status-color" style="background: @s.Color;"></div>
                        <div class="status-text">
                            <h6>@s.Name</h6>
                            <h4>@s.Count.ToString("N0")</h4>
                        </div>
                    </div>
                    <div class="status-percent">@s.Percent.ToString("0")%</div>
                </div>
            }
        </div>
    </div>

    <!-- CỘT PHẢI -->
    <div class="right-grid">

        <!-- BIỂU ĐỒ CỘT DOANH THU -->
        <div class="dash-card">
            <div class="card-header">
                <div class="card-title">Revenue Breakdown</div>
                <span class="dropdown-btn">Last 8 Months</span>
            </div>

            <div class="revenue-header-info">
                <div class="revenue-total">
                    <p>Booked value (excl. cancelled)</p>
                    <h3>@Model.RevenueSeriesTotal.ToString("N0") VNĐ</h3>
                </div>
                <div class="legend-list">
                    <div class="legend-item">
                        <div class="dot color-purple"></div> Venue Cost
                    </div>
                    <div class="legend-item">
                        <div class="dot color-green"></div> Add-on Cost
                    </div>
                </div>
            </div>

            <div class="chart-bar-container">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <!-- DANH SÁCH LOẠI SỰ KIỆN PHỔ BIẾN -->
        <div class="dash-card">
            <div class="card-header" style="margin-bottom: 15px;">
                <div class="card-title">Top Event Types</div>
                <span class="dropdown-btn">Top 5</span>
            </div>

            <div class="event-type-list">
                @if (Model.TopEventTypes.Any())
                {
                    int idx = 0;
                    foreach (var e in Model.TopEventTypes)
                    {
                        <div class="event-row">
                            <div class="event-name">@e.Name</div>
                            <div class="progress-bar-wrapper">
                                <div class="progress-fill @fillClasses[idx % fillClasses.Length]"
                                     style="width: @(e.Percent.ToString("0", inv))%; min-width: 36px;">@e.Percent.ToString("0")%</div>
                                </div>
                                <div class="event-count">@e.Count.ToString("N0") Bookings</div>
                            </div>
                            idx++;
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">Chưa có booking nào.</p>
                    }
            </div>
        </div>

    </div>
</div>

<!-- SCRIPTS KHỞI TẠO BIỂU ĐỒ BẰNG CHART.JS -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var ChartJs = /** @type {any} */ (window).Chart;
        if (!ChartJs) return;

        // Dữ liệu thật do DashboardController truyền sang
        const statusLabels = @Html.Raw(statusLabelsJs);
        const statusData = @Html.Raw(statusDataJs);
        const statusColors = @Html.Raw(statusColorsJs);
        const revenueLabels = @Html.Raw(revenueLabelsJs);
        const venueSeries = @Html.Raw(venueSeriesJs);
        const addOnSeries = @Html.Raw(addOnSeriesJs);

        // 1. BIỂU ĐỒ TRÒN (DONUT CHART) - BOOKING STATUS
        var donutCanvas = /** @type {HTMLCanvasElement|null} */ (document.getElementById('statusChart'));
        if (donutCanvas) {
            new ChartJs(donutCanvas.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusData,
                        backgroundColor: statusColors,
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '75%',
                    plugins: {
                        legend: { display: false },
                        tooltip: { enabled: true }
                    }
                }
            });
        }

        // 2. BIỂU ĐỒ CỘT (BAR CHART) - REVENUE BREAKDOWN
        var barCanvas = /** @type {HTMLCanvasElement|null} */ (document.getElementById('revenueChart'));
        if (barCanvas) {
            new ChartJs(barCanvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: revenueLabels,
                    datasets: [
                        {
                            label: 'Venue Cost',
                            data: venueSeries,
                            backgroundColor: '#DCE0FA',
                            borderRadius: 6,
                            barPercentage: 0.5,
                            categoryPercentage: 0.5
                        },
                        {
                            label: 'Add-on Cost',
                            data: addOnSeries,
                            backgroundColor: '#184A3B',
                            borderRadius: 6,
                            barPercentage: 0.5,
                            categoryPercentage: 0.5
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            mode: 'index',
                            intersect: false
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { color: '#738A7C', font: { size: 12 } }
                        },
                        y: {
                            grid: { color: '#F4F7FB' },
                            ticks: {
                                color: '#738A7C',
                                font: { size: 12 },
                                /** @param {number|string} value */
                                callback: function (value) {
                                    var n = Number(value);
                                    if (n === 0) return '0';
                                    if (n >= 1000000) return (n / 1000000) + 'M';
                                    return (n / 1000) + 'K';
                                }
                            },
                            beginAtZero: true
                        }
                    }
                }
            });
        }
    });
</script>