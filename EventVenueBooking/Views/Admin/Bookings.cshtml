                    <td>
                        <div class="action-btns" style="justify-content: flex-end;">
                            <button class="btn-act btn-view" title="Details" onclick="openViewModal('1001', 'Nguyen Van A', 'Grand Ballroom A', 'Wedding', '250', '25/10/2026 18:00', '25/10/2026 22:00', '$3,000', '$500', '$3,500', 'Confirmed')"><i class='bx bx-show'></i></button>
                            <button class="btn-act btn-edit" title="Edit" onclick="openEditModal('1001', '12', '1', '2', '250', '2026-10-25T18:00', '2026-10-25T22:00', '1')"><i class='bx bx-edit'></i></button>
