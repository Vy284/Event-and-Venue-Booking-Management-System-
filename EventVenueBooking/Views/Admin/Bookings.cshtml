<!-- 2. BẢNG DỮ LIỆU CHÍNH -->
<div class="crud-card">
    <div class="toolbar">
        <div class="filter-group">
            <input type="text" id="searchInput" class="custom-input" placeholder="Search Client / Venue..." style="width: 220px;" onkeyup="filterTable()">
