                        </div>
                    </td>
                </tr>

                <tr>
                    <td><strong>#1002</strong></td>
                    <td>
                        <div class="user-cell">
                            <div class="user-avatar-sm" style="background:#0288D1;">TB</div>
                            <div>
                                <div style="font-weight: 700;">Tran Thi B</div>
                                <div style="font-size: 11px; color: var(--text-muted);">Client #15</div>
                            </div>
                        </div>
                    </td>
                    <td>Skyline Garden</td>
                    <td>Birthday Party</td>
                    <td>80</td>
                    <td>01/11/2026 14:00</td>
                    <td style="font-weight: 700; color: var(--primary-green);">$1,200</td>
                    <td><span class="status-badge badge-pending">Pending</span></td>
                    <td>
                        <div class="action-btns" style="justify-content: flex-end;">
                            <button class="btn-act btn-view" title="Details" onclick="openViewModal('1002', 'Tran Thi B', 'Skyline Garden', 'Birthday Party', '80', '01/11/2026 14:00', '01/11/2026 18:00', '$1,000', '$200', '$1,200', 'Pending')"><i class='bx bx-show'></i></button>
                            <button class="btn-act btn-edit" title="Edit" onclick="openEditModal('1002', '15', '2', '1', '80', '2026-11-01T14:00', '2026-11-01T18:00', '0')"><i class='bx bx-edit'></i></button>
