<!-- 3. MODAL CREATE / EDIT BOOKING -->
<div class="modal-backdrop" id="bookingFormModal">
    <div class="modal-box">
        <div class="modal-header">
            <h3 id="modalTitle">Create New Booking</h3>
            <button class="btn-close-modal" onclick="closeModal('bookingFormModal')">&times;</button>
        </div>
        <form id="bookingForm" onsubmit="handleFormSubmit(event)">
            <input type="hidden" id="bookingId" name="BookingId" value="0">

            <div class="form-grid">
                <div class="form-group">
                    <label>Client User ID (*)</label>
                    <input type="number" class="form-control" id="clientUserId" required placeholder="Ex: 12">
                </div>

                <div class="form-group">
                    <label>Venue (*)</label>
                    <select class="form-control" id="venueId" required>
                        <option value="1">Grand Ballroom A</option>
                        <option value="2">Skyline Garden</option>
                        <option value="3">Executive Hall</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Event Type (*)</label>
                    <select class="form-control" id="eventTypeId" required>
                        <option value="1">Birthday Party</option>
                        <option value="2">Wedding</option>
                        <option value="3">Conference</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Guest Count (*)</label>
                    <input type="number" class="form-control" id="guestCount" required placeholder="Ex: 100">
                </div>

                <div class="form-group">
                    <label>Event Start DateTime (*)</label>
                    <input type="datetime-local" class="form-control" id="eventStartDateTime" required>
                </div>

                <div class="form-group">
                    <label>Event End DateTime (*)</label>
                    <input type="datetime-local" class="form-control" id="eventEndDateTime" required>
                </div>

                <div class="form-group full-width">
                    <label>Booking Status</label>
                    <select class="form-control" id="status">
                        <option value="0">0 - Pending</option>
                        <option value="1">1 - Confirmed</option>
                        <option value="2">2 - InProgress</option>
                        <option value="3">3 - Completed</option>
                        <option value="4">4 - Cancelled</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-secondary" onclick="closeModal('bookingFormModal')">Cancel</button>
                <button type="submit" class="btn-primary">Save Booking</button>
            </div>
        </form>
    </div>
</div>

<!-- 4. MODAL VIEW DETAILS -->
<div class="modal-backdrop" id="viewDetailsModal">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Booking Details <span id="vBookingId" style="color:var(--text-muted);"></span></h3>
            <button class="btn-close-modal" onclick="closeModal('viewDetailsModal')">&times;</button>
        </div>
        <div style="display: flex; flex-direction: column; gap: 12px; font-size: 13px;">
            <div style="display: flex; justify-content: space-between;"><strong>Client Name:</strong> <span id="vClientName"></span></div>
            <div style="display: flex; justify-content: space-between;"><strong>Venue:</strong> <span id="vVenue"></span></div>
            <div style="display: flex; justify-content: space-between;"><strong>Event Type:</strong> <span id="vEventType"></span></div>
            <div style="display: flex; justify-content: space-between;"><strong>Guest Count:</strong> <span id="vGuestCount"></span></div>
            <div style="display: flex; justify-content: space-between;"><strong>Start Time:</strong> <span id="vStart"></span></div>
            <div style="display: flex; justify-content: space-between;"><strong>End Time:</strong> <span id="vEnd"></span></div>
            <hr style="border: none; border-top: 1px dashed var(--border-color);">
            <div style="display: flex; justify-content: space-between;"><span>Venue Cost:</span> <span id="vVenueCost"></span></div>
            <div style="display: flex; justify-content: space-between;"><span>Add-On Cost:</span> <span id="vAddOnCost"></span></div>
            <div style="display: flex; justify-content: space-between; font-size: 16px; font-weight: 700; color: var(--primary-green);"><span>Total Cost:</span> <span id="vTotalCost"></span></div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
                <strong>Status:</strong> <span id="vStatusBadge"></span>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-secondary" onclick="closeModal('viewDetailsModal')">Close</button>
        </div>
    </div>
</div>

<!-- 5. MODAL CANCEL BOOKING (CANCEL REASON) -->
<div class="modal-backdrop" id="cancelModal">
    <div class="modal-box" style="max-width: 450px;">
        <div class="modal-header">
            <h3 style="color:#C62828;">Cancel Booking</h3>
            <button class="btn-close-modal" onclick="closeModal('cancelModal')">&times;</button>
        </div>
        <form onsubmit="handleCancelSubmit(event)">
            <input type="hidden" id="cancelBookingId">
            <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 12px;">Are you sure you want to cancel this booking? Please provide a reason below.</p>
            <div class="form-group">
                <label>Cancel Reason (*)</label>
                <textarea class="form-control" id="cancelReason" rows="3" required placeholder="Enter reason for cancellation..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" onclick="closeModal('cancelModal')">Close</button>
                <button type="submit" class="btn-primary" style="background:#C62828;">Confirm Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- JAVASCRIPT XỬ LÝ SỰ KIỆN CRUD & MODAL -->
<script>
// @ts-nocheck
            function openModal(id) {
            document.getElementById(id).classList.add('show');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('show');
        }

        function openCreateModal() {
            document.getElementById('modalTitle').innerText = "Create New Booking";
            document.getElementById('bookingForm').reset();
            document.getElementById('bookingId').value = "0";
            openModal('bookingFormModal');
        }

        function openEditModal(id, clientUser, venue, eventType, guests, start, end, status) {
            document.getElementById('modalTitle').innerText = "Edit Booking #" + id;
            document.getElementById('bookingId').value = id;
            document.getElementById('clientUserId').value = clientUser;
            document.getElementById('venueId').value = venue;
            document.getElementById('eventTypeId').value = eventType;
            document.getElementById('guestCount').value = guests;
            document.getElementById('eventStartDateTime').value = start;
            document.getElementById('eventEndDateTime').value = end;
            document.getElementById('status').value = status;
            openModal('bookingFormModal');
        }

        function openViewModal(id, client, venue, type, guests, start, end, venueCost, addonCost, total, status) {
            document.getElementById('vBookingId').innerText = "#" + id;
            document.getElementById('vClientName').innerText = client;
            document.getElementById('vVenue').innerText = venue;
            document.getElementById('vEventType').innerText = type;
            document.getElementById('vGuestCount').innerText = guests;
            document.getElementById('vStart').innerText = start;
            document.getElementById('vEnd').innerText = end;
            document.getElementById('vVenueCost').innerText = venueCost;
            document.getElementById('vAddOnCost').innerText = addonCost;
            document.getElementById('vTotalCost').innerText = total;
            document.getElementById('vStatusBadge').innerText = status;
            openModal('viewDetailsModal');
        }

        function openCancelModal(id) {
            document.getElementById('cancelBookingId').value = id;
            document.getElementById('cancelReason').value = "";
            openModal('cancelModal');
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            alert("Đã lưu Booking thành công!");
            closeModal('bookingFormModal');
        }

        function handleCancelSubmit(e) {
            e.preventDefault();
            const id = document.getElementById('cancelBookingId').value;
            const reason = document.getElementById('cancelReason').value;
            alert("Đã hủy Booking #" + id + " với lý do: " + reason);
            closeModal('cancelModal');
        }

        function filterTable() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const status = document.getElementById('statusFilter').value.toLowerCase();
            const rows = document.querySelectorAll('#bookingTable tbody tr');

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                const rowStatus = row.children[7].innerText.toLowerCase();

                const matchesSearch = text.includes(search);
                const matchesStatus = status === "" || rowStatus.includes(status);

                if (matchesSearch && matchesStatus) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }
</script>
   