@model EventVenueBooking.Entities.Venue

@{
    ViewData["Title"] = Model.Name + " - Chi tiết sảnh";
    var images = ViewBag.Images as List<EventVenueBooking.Entities.VenueImage>;
    var addOns = ViewBag.AddOnServices as List<EventVenueBooking.Entities.AddOnService>;

    // THÊM: đánh giá của khách cho sảnh này (do VenueController.Details nạp)
    var feedbacks = ViewBag.Feedbacks as List<EventVenueBooking.Entities.Feedback>;
    int reviewCount = ViewBag.ReviewCount ?? 0;
    double averageRating = ViewBag.AverageRating ?? 0.0;
    // Làm tròn tới 0.5 để vẽ nửa sao
    double ratingRounded = Math.Round(averageRating * 2, MidpointRounding.AwayFromZero) / 2.0;

    // Lấy ảnh trong images nếu không tìm được ảnh hiển thị
    var primaryImage = images?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl
               ?? images?.FirstOrDefault()?.ImageUrl
               ?? "/Content/images/bg_landingpage.jpg";
}

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>

<style>
    .calendar-dark-card {
        background-color: #3b2e27;
        border: 1px solid #524237;
    }

    .sticky-top {
        z-index: 100 !important;
    }

    .fc {
        --fc-page-bg-color: #3b2e27;
        --fc-border-color: #524237;
        --fc-neutral-bg-color: #483930;
        --fc-button-bg-color: #5c493e;
        --fc-button-border-color: #6b5549;
        --fc-button-hover-bg-color: #7a6254;
        --fc-button-hover-border-color: #7a6254;
        --fc-button-active-bg-color: #2a201b;
        --fc-button-active-border-color: #2a201b;
        font-family: inherit;
        color: #f5efe6 !important;
    }

        .fc .fc-scrollgrid,
        .fc .fc-daygrid-day {
            background-color: #3b2e27 !important;
            color: #f5efe6 !important;
        }

        .fc .fc-day-today {
            background-color: #524237 !important;
        }

        .fc a {
            color: #f5efe6 !important;
            text-decoration: none !important;
        }

        .fc .fc-col-header-cell-cushion {
            color: #d4a373 !important;
            font-weight: 600;
            padding: 10px 0 !important;
        }

        .fc .fc-toolbar-title {
            color: #3b2e27 !important;
        }
</style>

<div class="container py-5 mt-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Home/Index" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Home/Index#venue-gallery" class="text-decoration-none text-muted">Danh sách Sảnh</a></li>
            <li class="breadcrumb-item active fw-bold" style="color: var(--primary-brown);" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Feature Image & Thumbnails Gallery -->
            <div class="mb-4">
                <div class="rounded-4 overflow-hidden shadow-sm mb-3" style="height: 420px; background-color: #f5f5f5;">
                    <img id="main-venue-img" src="@primaryImage" alt="@Model.Name" class="w-100 h-100" style="object-fit: cover;" />
                </div>

                @if (images != null && images.Any())
                {
                    <div class="d-flex gap-2 overflow-auto pb-2">
                        @foreach (var img in images)
                        {
                            <div class="rounded-3 overflow-hidden border shadow-sm" style="width: 80px; height: 60px; cursor: pointer; flex-shrink: 0;" onclick="document.getElementById('main-venue-img').src='@img.ImageUrl';">
                                <img src="@img.ImageUrl" alt="Thumbnail" class="w-100 h-100" style="object-fit: cover;" />
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Name & Description -->
            <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge rounded-pill text-bg-warning px-3 py-2">@(Model.VenueType != null ? Model.VenueType.TypeName : "")</span>
                    <span class="text-muted"><i class="fa-solid fa-location-dot me-1 text-danger"></i>@Model.Location</span>
                </div>
                <h2 class="fw-bold mb-3" style="color: var(--primary-brown);">@Model.Name</h2>
                <p class="text-secondary lead fw-normal fs-5 mb-4">
                    @(string.IsNullOrEmpty(Model.Description) ? "Chưa có chú thích." : Model.Description)
                </p>

                <!-- Statistics -->
                <div class="row text-center g-3 pt-3 border-top">
                    <div class="col-6 col-md-4">
                        <div class="p-3 rounded-3 bg-light">
                            <i class="fa-solid fa-users fa-xl text-brown mb-2" style="color: var(--primary-brown);"></i>
                            <div class="small text-muted">Sức chứa tối đa</div>
                            <strong class="fs-5">@Model.Capacity người</strong>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="p-3 rounded-3 bg-light">
                            <i class="fa-solid fa-clock fa-xl text-brown mb-2" style="color: var(--primary-brown);"></i>
                            <div class="small text-muted">Hình thức thuê</div>
                            <strong class="fs-5">@(Model.RentalUnit == 0 ? "Theo Giờ" : Model.RentalUnit == 1 ? "Theo Buổi" : "Theo Ngày")</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Lịch trống của sảnh -->
            <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold m-0" style="color: var(--primary-brown);">
                        <i class="fa-regular fa-calendar-days me-2"></i>Lịch trống của sảnh
                    </h4>
                    <div class="small">
                        <span class="badge bg-danger me-1">■ Đã được đặt</span>
                        <span class="badge bg-success">■ Còn trống</span>
                    </div>
                </div>
                <p class="text-muted small mb-3">Vui lòng kiểm tra lịch bên dưới để chọn ngày giờ tổ chức sự kiện phù hợp.</p>

                <!-- Khung chứa Lịch -->
                <div id="venue-calendar" style="min-height: 400px;"></div>
            </div>

            <!-- Facilities -->
            <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
                <h4 class="fw-bold mb-3" style="color: var(--primary-brown);">Trang thiết bị & Tiện ích</h4>
                <div class="row g-3">
                    @if (Model.VenueFacilities != null && Model.VenueFacilities.Any(x => x.Facility != null && x.Facility.IsActive))
                    {
                        foreach (var vf in Model.VenueFacilities.Where(x => x.Facility != null && x.Facility.IsActive))
                        {
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-circle-check text-success"></i>
                                    <span>@vf.Facility.FacilityName</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted fs-5 mb-0">Chưa có thông tin tiện ích chi tiết.</p>
                    }
                </div>
            </div>

            <!-- Add-on Services -->
            <div class="bg-white p-4 rounded-4 shadow-sm">
                <h4 class="fw-bold mb-3" style="color: var(--primary-brown);">Dịch vụ Add-on tùy chọn</h4>
                <div class="list-group list-group-flush">
                    @if (addOns != null && addOns.Any())
                    {
                        foreach (var addon in addOns)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                                <div>
                                    <h6 class="mb-1 fw-bold fs-5">@addon.Name</h6>
                                    <p class="text-muted fs-6">@addon.Description</p>
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold text-danger d-block">+@addon.Price.ToString("N0") VNĐ</span>
                                    <span class="badge bg-light text-dark border">@addon.Category</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Feedback & Ratings Section -->
            <div class="bg-white p-4 rounded-4 shadow-sm mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h4 class="fw-bold m-0" style="color: var(--primary-brown);">
                        <i class="fa-regular fa-star-half-stroke me-2"></i>Đánh giá & Phản hồi từ khách hàng
                    </h4>
                    <div class="text-warning fs-6">
                        @for (int s = 1; s <= 5; s++)
                        {
                            if (ratingRounded >= s)
                            {
                                <i class="fa-solid fa-star"></i>
                            }
                            else if (ratingRounded >= s - 0.5)
                            {
                                <i class="fa-solid fa-star-half-stroke"></i>
                            }
                            else
                            {
                                <i class="fa-regular fa-star"></i>
                            }
                        }
                        <span class="text-dark fw-bold ms-1">@averageRating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) / 5</span>
                        <span class="text-muted small ms-1">(@reviewCount đánh giá)</span>
                    </div>
                </div>

                <div class="d-flex flex-column">
                    @if (feedbacks != null && feedbacks.Any())
                    {
                        foreach (var fb in feedbacks)
                        {
                            string reviewer = (fb.Booking != null && fb.Booking.ClientUser != null && !string.IsNullOrWhiteSpace(fb.Booking.ClientUser.FullName))
                                ? fb.Booking.ClientUser.FullName.Trim()
                                : "Khách hàng";
                            string initial = reviewer.Substring(0, 1).ToUpper();

                            <div class="py-3 border-bottom">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                                         style="width: 40px; height: 40px; background-color: var(--primary-brown, #4a3b32);">@initial</div>
                                        <div>
                                            <div class="fw-bold">@reviewer</div>
                                            <div class="small text-muted">@fb.CreatedAt.ToString("dd/MM/yyyy")</div>
                                        </div>
                                        <div class="ms-auto text-warning small">
                                            @for (int s = 1; s <= 5; s++)
                                            {
                                                <i class="@(s <= fb.Rating ? "fa-solid" : "fa-regular") fa-star"></i>
                                            }
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(fb.Comment))
                                    {
                                        <p class="mb-0 text-secondary">@fb.Comment</p>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="py-3">
                                <p class="text-muted fs-5 mb-0">Hiện tại chưa có đánh giá nào cho sảnh này.</p>
                            </div>
                        }
                </div>
            </div>

        </div>

        <!-- Price & Booking Sidebar -->
        <div class="col-lg-4">
            <div class="bg-white p-4 rounded-4 shadow-sm sticky-top" style="top: 100px;">
                <h5 class="text-muted small text-uppercase fw-bold">Giá thuê sảnh</h5>
                <div class="d-flex align-items-baseline gap-2 mb-4">
                    <span class="fs-2 fw-bold text-danger">@Model.RentalRate.ToString("N0") VNĐ</span>
                    <span class="text-muted">/ @(Model.RentalUnit == 0 ? "Giờ" : Model.RentalUnit == 1 ? "Buổi" : "Ngày")</span>
                </div>

                <hr />

                <div class="d-grid gap-3 mt-4">
                    <a href="javascript:void(0);" id="btn-book-now" class="btn btn-brown py-3 fs-6 fw-bold shadow">
                        <i class="fa-regular fa-calendar-check me-2"></i>ĐẶT SẢNH NGAY
                    </a>
                    <a href="tel:0901234567" class="btn btn-outline-dark py-2 rounded-pill">
                        <i class="fa-solid fa-phone me-2"></i>Liên hệ tư vấn
                    </a>
                </div>

                <div class="mt-4 pt-3 border-top text-center text-muted small">
                    <i class="fa-solid fa-shield-halved me-1 text-success"></i> Cam kết giữ giá & không phát sinh chi phí ẩn.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- script khởi tạo FullCalendar -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('venue-calendar');
        var venueId = @Model.VenueId;

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek'
            },
            buttonText: {
                today: 'Hôm nay',
                month: 'Tháng',
                week: 'Tuần'
            },
            locale: 'vi',
            events: '/Venue/GetVenueBookings?venueId=' + venueId
        });

        calendar.render();
    });

    document.addEventListener('DOMContentLoaded', function () {
        var bookBtn = document.getElementById('btn-book-now');
        var isUserLoggedIn = @((Session["User"] != null).ToString().ToLower());
        var venueId = @Model.VenueId;

        if (bookBtn) {
            bookBtn.addEventListener('click', function (e) {
                e.preventDefault();

                if (!isUserLoggedIn) {
                    showCustomToast("Vui lòng đăng nhập trước khi tiến hành đặt sảnh!");

                    var authModalEl = document.getElementById('authModal');
                    if (authModalEl) {
                        var authModal = new bootstrap.Modal(authModalEl);
                        authModal.show();
                        var loginTab = document.getElementById('pills-login-tab');
                        if (loginTab) loginTab.click();
                    }
                } else {
                    window.location.href = '/ClientBooking/Create?venueId=' + venueId;
                }
            });
        }
    });

    function showCustomToast(message) {
        var existingToast = document.getElementById('dynamicGlobalToast');
        if (existingToast) existingToast.remove();

        var toastHtml = `
            <div id="dynamicGlobalToast" class="position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 99999;">
                <div class="toast align-items-center text-white border-0 shadow-lg show" role="alert" aria-live="assertive" aria-atomic="true"
                     style="background-color: #4A3525; border-radius: 12px; width: max-content; max-width: 90vw; transition: all 0.5s ease;">
                    <div class="d-flex p-2 align-items-center justify-content-between">
                        <div class="toast-body d-flex align-items-center gap-2 fs-6">
                            <i class="fa-solid fa-circle-exclamation fs-4 text-warning"></i>
                            <span class="fw-medium">${message}</span>
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            </div>
        `;

        document.body.insertAdjacentHTML('beforeend', toastHtml);

        var toastEl = document.getElementById('dynamicGlobalToast');
        setTimeout(function () {
            if (toastEl) {
                toastEl.style.opacity = '0';
                setTimeout(function () { toastEl.remove(); }, 500);
            }
        }, 3500);
    }
</script>