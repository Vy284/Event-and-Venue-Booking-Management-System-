@model EventVenueBooking.Entities.Venue

@{
    ViewData["Title"] = Model.Name + " - Chi tiết sảnh";
    var images = ViewBag.Images as List<EventVenueBooking.Entities.VenueImage>;
    var addOns = ViewBag.AddOnServices as List<EventVenueBooking.Entities.AddOnService>;

    // Lấy ảnh trong images nếu không tìm được ảnh hiển thị
    var primaryImage = images?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl
               ?? images?.FirstOrDefault()?.ImageUrl
               ?? "/Content/images/bg_landingpage.jpg";
}

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>

<style>
    .calendar-dark-card {
        background-color: #3b2e27;
        border: 1px solid #524237;
    }

    .fc {
        --fc-page-bg-color: #3b2e27;
        --fc-border-color: #524237;
        --fc-neutral-bg-color: #483930;
        --fc-button-bg-color: #5c493e;
        --fc-button-border-color: #6b5549;
        --fc-button-hover-bg-color: #7a6254;
        --fc-button-hover-border-color: #7a6254;
        --fc-button-active-bg-color: #2a201b;
        --fc-button-active-border-color: #2a201b;
        font-family: inherit;
        color: #f5efe6 !important;
    }

        .fc .fc-scrollgrid,
        .fc .fc-daygrid-day {
            background-color: #3b2e27 !important;
            color: #f5efe6 !important;
        }

        .fc .fc-day-today {
            background-color: #524237 !important;
        }

        .fc a {
            color: #f5efe6 !important;
            text-decoration: none !important;
        }

        .fc .fc-col-header-cell-cushion {
            color: #d4a373 !important;
            font-weight: 600;
            padding: 10px 0 !important;
        }

        .fc .fc-toolbar-title {
            color: #3b2e27 !important;
        }
</style>

<div class="container py-5 mt-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Home/Index" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Home/Index#venue-gallery" class="text-decoration-none text-muted">Danh sách Sảnh</a></li>
            <li class="breadcrumb-item active fw-bold" style="color: var(--primary-brown);" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Feature Image -->
            <div class="rounded-4 overflow-hidden shadow-sm mb-4" style="height: 420px;">
                <img src="@primaryImage" alt="@Model.Name" class="w-100 h-100" style="object-fit: cover;" />
            </div>

            <!-- Name & Description -->
            <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge rounded-pill text-bg-warning px-3 py-2">@(Model.VenueType != null ? Model.VenueType.TypeName : "")</span>
                    <span class="text-muted"><i class="fa-solid fa-location-dot me-1 text-danger"></i>@Model.Location</span>
                </div>
                <h2 class="fw-bold mb-3" style="color: var(--primary-brown);">@Model.Name</h2>
                <p class="text-secondary lead fs-6 mb-4">
                    @(string.IsNullOrEmpty(Model.Description) ? "Không gian sang trọng, đẳng cấp phù hợp cho mọi loại hình sự kiện tiệc cưới, hội thảo và gặp mặt doanh nghiệp." : Model.Description)
                </p>

                <!-- Statistics -->
                <div class="row text-center g-3 pt-3 border-top">
                    <div class="col-6 col-md-4">
                        <div class="p-3 rounded-3 bg-light">
                            <i class="fa-solid fa-users fa-xl text-brown mb-2" style="color: var(--primary-brown);"></i>
                            <div class="small text-muted">Sức chứa tối đa</div>
                            <strong class="fs-5">@Model.Capacity người</strong>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="p-3 rounded-3 bg-light">
                            <i class="fa-solid fa-clock fa-xl text-brown mb-2" style="color: var(--primary-brown);"></i>
                            <div class="small text-muted">Hình thức thuê</div>
                            <strong class="fs-5">@(Model.RentalUnit == 0 ? "Theo Giờ" : Model.RentalUnit == 1 ? "Theo Buổi" : "Theo Ngày")</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Lịch trống của sảnh -->
            <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold m-0" style="color: var(--primary-brown);">
                        <i class="fa-regular fa-calendar-days me-2"></i>Lịch trống của sảnh
                    </h4>
                    <div class="small">
                        <span class="badge bg-danger me-1">■ Đã được đặt</span>
                        <span class="badge bg-success">■ Còn trống</span>
                    </div>
                </div>
                <p class="text-muted small mb-3">Vui lòng kiểm tra lịch bên dưới để chọn ngày giờ tổ chức sự kiện phù hợp.</p>

                <!-- Khung chứa Lịch -->
                <div id="venue-calendar" style="min-height: 400px;"></div>
            </div>

            <!-- Facilities (SỬA: dùng VenueFacilities -> Facility) -->
            <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
                <h4 class="fw-bold mb-3" style="color: var(--primary-brown);">Trang thiết bị & Tiện ích</h4>
                <div class="row g-3">
                    @if (Model.VenueFacilities != null && Model.VenueFacilities.Any(x => x.Facility != null && x.Facility.IsActive))
                    {
                        foreach (var vf in Model.VenueFacilities.Where(x => x.Facility != null && x.Facility.IsActive))
                        {
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-circle-check text-success"></i>
                                    <span>@vf.Facility.FacilityName</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">Chưa có thông tin tiện ích chi tiết.</p>
                    }
                </div>
            </div>

            <!-- Add-on Services -->
            <div class="bg-white p-4 rounded-4 shadow-sm">
                <h4 class="fw-bold mb-3" style="color: var(--primary-brown);">Dịch vụ Add-on tùy chọn</h4>
                <div class="list-group list-group-flush">
                    @if (addOns != null && addOns.Any())
                    {
                        foreach (var addon in addOns)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                                <div>
                                    <h6 class="mb-1 fw-bold">@addon.Name</h6>
                                    <small class="text-muted">@addon.Description</small>
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold text-danger d-block">+@addon.Price.ToString("N0") VNĐ</span>
                                    <span class="badge bg-light text-dark border">@addon.Category</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Price & Booking Sidebar -->
        <div class="col-lg-4">
            <div class="bg-white p-4 rounded-4 shadow-sm sticky-top" style="top: 100px;">
                <h5 class="text-muted small text-uppercase fw-bold">Giá thuê sảnh</h5>
                <div class="d-flex align-items-baseline gap-2 mb-4">
                    <span class="fs-2 fw-bold text-danger">@Model.RentalRate.ToString("N0") VNĐ</span>
                    <span class="text-muted">/ @(Model.RentalUnit == 0 ? "Giờ" : Model.RentalUnit == 1 ? "Buổi" : "Ngày")</span>
                </div>

                <hr />

                <div class="d-grid gap-3 mt-4">
                    @* SỬA: trỏ sang ClientBookingController *@
                    <a href="@Url.Action("Create", "ClientBooking", new { venueId = Model.VenueId })" class="btn btn-brown py-3 fs-6 fw-bold shadow">
                        <i class="fa-regular fa-calendar-check me-2"></i>ĐẶT SẢNH NGAY
                    </a>
                    <a href="tel:0901234567" class="btn btn-outline-dark py-2 rounded-pill">
                        <i class="fa-solid fa-phone me-2"></i>Liên hệ tư vấn
                    </a>
                </div>

                <div class="mt-4 pt-3 border-top text-center text-muted small">
                    <i class="fa-solid fa-shield-halved me-1 text-success"></i> Cam kết giữ giá & không phát sinh chi phí ẩn.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- script khởi tạo FullCalendar -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('venue-calendar');
        var venueId = @Model.VenueId;

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek'
            },
            buttonText: {
                today: 'Hôm nay',
                month: 'Tháng',
                week: 'Tuần'
            },
            locale: 'vi',
            // Load các đơn đặt của sảnh này từ Controller API
            events: '/Venue/GetVenueBookings?venueId=' + venueId,
            eventClick: function(info) {
                alert('Khung giờ này đã được đặt: ' + info.event.title);
            }
        });

        calendar.render();
    });
</script>