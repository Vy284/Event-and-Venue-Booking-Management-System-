@model EventVenueBooking.Entities.Booking

@{
    ViewBag.Title = "Create";

    // Giữ lại giá trị đã nhập khi form báo lỗi (Model là null khi mở trang lần đầu)
    string startValue = (Model != null && Model.EventStartDateTime != default(DateTime))
        ? Model.EventStartDateTime.ToString("yyyy-MM-ddTHH:mm") : "";
    string endValue = (Model != null && Model.EventEndDateTime != default(DateTime))
        ? Model.EventEndDateTime.ToString("yyyy-MM-ddTHH:mm") : "";
    string guestValue = (Model != null && Model.GuestCount > 0) ? Model.GuestCount.ToString() : "1";
}

<h2>Tạo booking</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Booking</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            <label class="control-label col-md-2" for="ClientUserId">Khách hàng</label>
            <div class="col-md-10">
                @Html.DropDownList("ClientUserId", null, htmlAttributes: new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2" for="VenueId">Địa điểm</label>
            <div class="col-md-10">
                @Html.DropDownList("VenueId", null, htmlAttributes: new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2" for="EventTypeId">Loại sự kiện</label>
            <div class="col-md-10">
                @Html.DropDownList("EventTypeId", null, htmlAttributes: new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2" for="guestCount">Số khách</label>
            <div class="col-md-10">
                @Html.TextBox("guestCount", guestValue, new { type = "number", min = "1", required = "required", @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2" for="eventStartDateTime">Bắt đầu</label>
            <div class="col-md-10">
                @Html.TextBox("eventStartDateTime", startValue, new { type = "datetime-local", required = "required", @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2" for="eventEndDateTime">Kết thúc</label>
            <div class="col-md-10">
                @Html.TextBox("eventEndDateTime", endValue, new { type = "datetime-local", required = "required", @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <p class="text-muted">Giá và trạng thái do hệ thống tự tính. Booking mới luôn ở trạng thái Pending.</p>
                <input type="submit" value="Tạo booking" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Quay lại danh sách", "Index")
</div>