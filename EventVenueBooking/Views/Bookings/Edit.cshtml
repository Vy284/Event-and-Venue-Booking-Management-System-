@model EventVenueBooking.Entities.Booking
@{
    ViewBag.Title = "Chỉnh sửa Booking #" + Model.BookingId;
    ViewBag.ActiveMenu = "Bookings";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var statusNames = new[] { "Pending", "Confirmed", "InProgress", "Completed", "Cancelled" };
    var statusItems = statusNames.Select((name, index) => new SelectListItem
    {
        Value = index.ToString(),
        Text = name,
        Selected = (index == Model.Status)
    }).ToList();
}

<style>
    .edit-card {
        background: #FFFFFF;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
        max-width: 850px;
        margin: 0 auto;
    }

    .edit-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #F0F4F1;
    }

    .edit-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--primary-green, #184A3B);
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .form-group.full {
            grid-column: span 2;
        }

        .form-group label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted, #738A7C);
        }

    .form-control {
        background: #F4F7FB;
        border: 1px solid #E0E6ED;
        padding: 10px 14px;
        border-radius: 10px;
        font-size: 13px;
        outline: none;
        color: #1C2A23;
        transition: border-color 0.2s;
    }

        .form-control:focus {
            border-color: var(--primary-green, #184A3B);
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid #F0F4F1;
    }

    .btn-cancel {
        background: #F4F7FB;
        color: #5D7285;
        border: none;
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 13px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-save {
        background: var(--primary-green, #184A3B);
        color: #FFFFFF;
        border: none;
        padding: 10px 24px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        transition: opacity 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-save:hover {
            opacity: 0.9;
        }

    .validation-summary-errors {
        background: #FFEBEE;
        color: #C62828;
        padding: 12px 16px;
        border-radius: 12px;
        margin-bottom: 20px;
        font-size: 13px;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 20px;
        }
</style>

<div class="edit-card">
    <div class="edit-header">
        <div class="edit-title"><i class='bx bx-edit-alt'></i> Chỉnh sửa Booking #@Model.BookingId</div>
        <a href="@Url.Action("Index", "Bookings")" class="btn-cancel"><i class='bx bx-arrow-back'></i> Quay lại danh sách</a>
    </div>

    @Html.ValidationSummary(true, "")

    @using (Html.BeginForm("Edit", "Bookings", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="bookingId" value="@Model.BookingId" />

        <div class="form-grid">
            <div class="form-group full">
                <label>Khách hàng đặt chỗ</label>
                <input type="text" class="form-control" value="@(Model.ClientUser != null ? Model.ClientUser.FullName : "N/A")" disabled />
            </div>

            <div class="form-group">
                <label>Sảnh / Địa điểm (*)</label>
                <select name="venueId" class="form-control" required>
                    @foreach (var v in (SelectList)ViewBag.VenueId)
                    {
                        <option value="@v.Value" @(v.Value == Model.VenueId.ToString() ? "selected" : "")>@v.Text</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Loại sự kiện (*)</label>
                <select name="eventTypeId" class="form-control" required>
                    @foreach (var et in (SelectList)ViewBag.EventTypeId)
                    {
                        <option value="@et.Value" @(et.Value == Model.EventTypeId.ToString() ? "selected" : "")>@et.Text</option>
                    }
                </select>
            </div>

            <div class="form-group full">
                <label>Số lượng khách tham dự (*)</label>
                <input type="number" class="form-control" name="guestCount" value="@Model.GuestCount" min="1" required />
            </div>

            <div class="form-group">
                <label>Thời gian bắt đầu (*)</label>
                <input type="datetime-local" class="form-control" name="eventStartDateTime"
                       value="@Model.EventStartDateTime.ToString("yyyy-MM-ddTHH:mm")" required />
            </div>

            <div class="form-group">
                <label>Thời gian kết thúc (*)</label>
                <input type="datetime-local" class="form-control" name="eventEndDateTime"
                       value="@Model.EventEndDateTime.ToString("yyyy-MM-ddTHH:mm")" required />
            </div>

            <div class="form-group full">
                <label>Trạng thái đơn hàng</label>
                @Html.DropDownList("status", statusItems, new { @class = "form-control" })
                <small class="text-muted" style="margin-top: 4px; font-size: 11px;">
                    Thứ tự trạng thái: Pending (Chờ cọc) &rarr; Confirmed (Đã xác nhận) &rarr; InProgress (Đang diễn ra) &rarr; Completed (Hoàn tất). Chọn Cancelled để hủy đơn.<br />
                    Sảnh, loại sự kiện, số khách và thời gian chỉ sửa được khi booking còn Pending và chưa thu tiền.
                </small>
            </div>
        </div>

        <div class="form-actions">
            <a href="@Url.Action("Index", "Bookings")" class="btn-cancel">Hủy bỏ</a>
            <button type="submit" class="btn-save"><i class='bx bx-check'></i> Lưu thay đổi</button>
        </div>
    }
</div>