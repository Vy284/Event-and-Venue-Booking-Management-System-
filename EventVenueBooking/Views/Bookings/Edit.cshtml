@model EventVenueBooking.Entities.Booking

@{
    ViewBag.Title = "Edit";

    var statusNames = new[] { "Pending", "Confirmed", "InProgress", "Completed", "Cancelled" };
    var statusItems = statusNames.Select((name, index) => new SelectListItem
    {
        Value = index.ToString(),
        Text = name,
        Selected = (index == Model.Status)
    }).ToList();

    // Completed (3) và Cancelled (4) là trạng thái cuối, không đổi nữa
    bool isFinal = Model.Status == 3 || Model.Status == 4;
}

<h2>Cập nhật trạng thái booking</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Booking #@Model.BookingId</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.BookingId)

        <dl class="dl-horizontal">
            <dt>Khách hàng</dt>
            <dd>@(Model.ClientUser != null ? Model.ClientUser.FullName : "N/A")</dd>

            <dt>Địa điểm</dt>
            <dd>@(Model.Venue != null ? Model.Venue.Name : "N/A")</dd>

            <dt>Bắt đầu</dt>
            <dd>@Model.EventStartDateTime.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt>Kết thúc</dt>
            <dd>@Model.EventEndDateTime.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt>Tổng tiền</dt>
            <dd>@(Model.TotalCost.ToString("N0")) VND</dd>
        </dl>

        @if (isFinal)
        {
            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <p class="text-muted">Booking đã ở trạng thái cuối (@statusNames[Model.Status]), không thể đổi trạng thái nữa.</p>
                </div>
            </div>
        }
        else
        {
            <div class="form-group">
                <label class="control-label col-md-2" for="status">Trạng thái</label>
                <div class="col-md-10">
                    @Html.DropDownList("status", statusItems, new { @class = "form-control" })
                    <p class="help-block">Thứ tự: Pending, Confirmed, InProgress, Completed. Chọn Cancelled để hủy booking.</p>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Lưu" class="btn btn-default" />
                </div>
            </div>
        }
    </div>
}

<div>
    @Html.ActionLink("Quay lại danh sách", "Index")
</div>