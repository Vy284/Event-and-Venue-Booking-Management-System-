<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - VenueHub Event Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css">
    <style>
        :root {
            --bg-main: #E3EDE6;
            --bg-card: #FFFFFF;
            --sidebar-bg: #E3EDE6;
            --primary-green: #184A3B;
            --active-item-bg: #FFFFFF;
            --text-dark: #1C2A23;
            --text-muted: #738A7C;
            --border-color: #D3E0D7;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-main);
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        .sidebar {
            width: 260px;
            background-color: var(--sidebar-bg);
            padding: 24px 18px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            flex-shrink: 0;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 22px;
            font-weight: 800;
            color: var(--primary-green);
            padding-left: 10px;
            margin-bottom: 30px;
            text-decoration: none;
        }

            .brand-logo:hover {
                opacity: 0.85;
            }

        .nav-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 11px 16px;
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            border-radius: 10px;
            transition: all 0.2s ease;
            position: relative;
        }

            .nav-link.active::before {
                content: "";
                position: absolute;
                left: -18px;
                top: 50%;
                transform: translateY(-50%);
                width: 4px;
                height: 24px;
                background-color: var(--primary-green);
                border-radius: 0 4px 4px 0;
            }

            .nav-link:hover, .nav-link.active {
                background-color: var(--active-item-bg);
                color: var(--primary-green);
                box-shadow: 0 4px 12px rgba(24, 74, 59, 0.05);
            }

        .sidebar-bottom {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .btn-signout {
            width: 100%;
            background: transparent;
            border: 1.5px solid var(--primary-green);
            color: var(--primary-green);
            padding: 10px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
        }

        .main-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            padding: 16px 20px 16px 0;
        }

        .content-container {
            background-color: #F4F7F5;
            flex-grow: 1;
            border-radius: 24px;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            border: none;
            box-shadow: -4px 4px 15px rgba(0,0,0,0.02);
        }

        .main-header {
            padding: 20px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: transparent;
        }

        .header-title h2 {
            font-size: 22px;
            color: var(--primary-green);
            font-weight: 700;
        }

        .header-title p {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .search-box {
            position: relative;
        }

            .search-box input {
                background: #FFFFFF;
                border: 1px solid var(--border-color);
                padding: 10px 16px 10px 40px;
                border-radius: 30px;
                font-size: 13px;
                width: 260px;
                outline: none;
            }

            .search-box i {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                font-size: 18px;
            }

        .icon-btn {
            width: 38px;
            height: 38px;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary-green);
            font-size: 18px;
            cursor: pointer;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            padding-left: 10px;
        }

        .avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            object-fit: cover;
        }

        .user-info .name {
            font-weight: 700;
            font-size: 13px;
            color: var(--text-dark);
        }

        .user-info .role {
            font-size: 11px;
            color: var(--text-muted);
        }

        .page-body {
            padding: 0 30px 30px 30px;
            flex-grow: 1;
        }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div>
            @* Logo bấm về trang chủ *@
            <a href="@Url.Action("Index", "Home")" class="brand-logo">
                <i class='bx bxs-shapes'></i> VenueHub
            </a>
            <ul class="nav-list">
                <li>
                    <a href="@Url.Action("Index", "Home")" class="nav-link">
                        <i class='bx bx-home-alt'></i> Home
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Dashboard")" class="nav-link @(ViewBag.ActiveMenu == "Dashboard" ? "active" : "")">
                        <i class='bx bx-grid-alt'></i> Dashboard
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Calendar", "Dashboard")" class="nav-link @(ViewBag.ActiveMenu == "Calendar" ? "active" : "")">
                        <i class='bx bx-calendar'></i> Calendar
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Bookings")" class="nav-link @(ViewBag.ActiveMenu == "Bookings" ? "active" : "")">
                        <i class='bx bx-receipt'></i> Bookings
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Venues")" class="nav-link @(ViewBag.ActiveMenu == "Venues" ? "active" : "")">
                        <i class='bx bx-building-house'></i> Venues
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Facilities_Services", "Venues")" class="nav-link @(ViewBag.ActiveMenu == "Facilities" ? "active" : "")">
                        <i class='bx bx-cube'></i> Facilities & Services
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Payments")" class="nav-link @(ViewBag.ActiveMenu == "Payments" ? "active" : "")">
                        <i class='bx bx-wallet'></i> Payments
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Users")" class="nav-link @(ViewBag.ActiveMenu == "Users" ? "active" : "")">
                        <i class='bx bx-user'></i> Users
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Feedback", "Users")" class="nav-link @(ViewBag.ActiveMenu == "Feedback" ? "active" : "")">
                        <i class='bx bx-star'></i> Feedback
                    </a>
                </li>
            </ul>
        </div>
        <div class="sidebar-bottom">
            @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-signout">
                    <i class='bx bx-log-out'></i> Sign Out
                </button>
            }
        </div>
    </aside>
    <div class="main-wrapper">
        <div class="content-container">
            <!-- HEADER -->
            <header class="main-header">
                <div class="header-title">
                    <h2>@(ViewBag.Title ?? "Dashboard")</h2>
                    <p>Hello @User.Identity.Name, welcome back!</p>
                </div>
                <div class="header-actions">
                    <!-- Đã xóa bỏ ô search, chuông thông báo và bánh răng cài đặt theo yêu cầu -->
                    <div class="user-profile">
                        <!-- Thay vì dùng thẻ img, dùng một div bo tròn CSS giống bên bảng Users -->
                        <div style="width: 38px; height: 38px; border-radius: 50%; background: #184A3B; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700;">
                            @(User.IsInRole("Admin") ? "A" : "N")
                        </div>
                        <div class="user-info">
                            <div class="name">@User.Identity.Name</div>
                            <div class="role">@(User.IsInRole("Admin") ? "Admin" : "Coordinator")</div>
                        </div>
                    </div>
                </div>
            </header>
            <main class="page-body">
                @RenderBody()
            </main>
        </div>
    </div>
</body>
</html>