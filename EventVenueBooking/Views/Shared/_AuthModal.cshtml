@{
    var oldRegister = TempData["RegisterData"] as EventVenueBooking.ViewModels.RegisterViewModel;
    var shouldOpenRegister = TempData["OpenRegisterModal"] != null;
    var shouldOpenLogin = TempData["OpenLoginModal"] != null;

    var loginError = shouldOpenLogin ? TempData["ErrorMessage"] as string : null;
    var registerError = shouldOpenRegister ? TempData["ErrorMessage"] as string : null;

}

<style>
    #authModal .nav-pills .nav-link {
        color: #5A4E46;
        transition: all 0.3s ease;
    }

        #authModal .nav-pills .nav-link.active {
            background-color: #C2A682 !important;
            color: #ffffff !important;
        }

    #authModal .form-control {
        height: 50px;
        font-size: 1rem;
    }

        #authModal .form-control:focus {
            border-color: #C2A682 !important;
            box-shadow: 0 0 0 0.25rem rgba(194, 166, 130, 0.2) !important;
        }
</style>

<div class="modal fade" id="authModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 70%;">
        <div class="modal-content overflow-hidden border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-body p-0">
                <div class="row g-0">

                    <div class="col-md-5 d-none d-md-block position-relative"
                         style="background: url('https://images.unsplash.com/photo-1519671482749-fd09be7ccebf?q=80&w=1170') center/cover no-repeat; min-height: 560px;">
                        <div class="position-absolute top-0 start-0 w-100 h-100" style="background: rgba(0,0,0,0.12);"></div>
                    </div>

                    <div class="col-md-7 p-4 p-lg-5 d-flex flex-column justify-content-center" style="background-color: #FAF8F5;">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fs-4 fw-bold text-uppercase" style="color: #4A3B32; font-family: 'Playfair Display', serif; letter-spacing: 2px;">EVENTVENUE</span>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <!-- Tab Login - Register -->
                        <ul class="nav nav-pills nav-justified mb-4 p-1" style="background-color: #EFECE6;">
                            <li class="nav-item">
                                <button class="nav-link active fw-bold py-2" id="pills-login-tab" data-bs-toggle="pill" data-bs-target="#pills-login" type="button">Đăng Nhập</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link fw-bold py-2" id="pills-register-tab" data-bs-toggle="pill" data-bs-target="#pills-register" type="button">Đăng Ký</button>
                            </li>
                        </ul>

                        <div class="tab-content" id="pills-tabContent">
                            <!-- Login Tab -->
                            <div class="tab-pane fade show active" id="pills-login">
                                <h2 class="fw-normal mb-1" style="font-family: 'Playfair Display', serif; color: #2B2623; font-size: 2.2rem;">Welcome Back!</h2>
                                <p class="text-muted small mb-3 text-uppercase" style="font-size: 0.9rem; letter-spacing: 1px;">Nhập thông tin tài khoản của bạn</p>

                                <!-- Khung báo lỗi Login AJAX -->
                                <div id="loginAlert" class="alert alert-danger py-2 px-3 mb-3 border-0 rounded-3 small d-none align-items-center gap-2">
                                    <i class="fa-solid fa-circle-exclamation"></i>
                                    <span id="loginAlertText"></span>
                                </div>

                                @if (!string.IsNullOrEmpty(loginError))
                                {
                                    <div class="alert alert-danger py-2 px-3 mb-3 border-0 rounded-3 small d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-circle-exclamation"></i>
                                        <span>@loginError</span>
                                    </div>
                                }

                                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { id = "loginForm" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <div class="mb-3">
                                        <input type="email" name="Email" class="form-control border-0 px-3 shadow-sm bg-white fs-6" placeholder="Địa chỉ Email" required />
                                    </div>
                                    <div class="mb-3">
                                        <input type="password" name="Password" class="form-control border-0 px-3 shadow-sm bg-white fs-6" placeholder="Mật khẩu" required />
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-4 fs-6 fst-italic">
                                        <div class="form-check">
                                            <input class="form-check-input border-secondary" type="checkbox" id="rememberMe">
                                            <label class="form-check-label text-muted" for="rememberMe">Ghi nhớ tôi</label>
                                        </div>
                                        <a href="#" class="text-decoration-none text-muted">Quên mật khẩu?</a>
                                    </div>
                                    <button type="submit" id="btnLoginSubmit" class="btn w-100 py-3 text-white fw-bold shadow-sm fs-5" style="background-color: #C2A682; border-radius: 8px; letter-spacing: 1px;">ĐĂNG NHẬP</button>
                                }
                            </div>

                            <!-- Register Tab -->
                            <div class="tab-pane fade" id="pills-register">
                                <h2 class="fw-normal mb-1" style="font-family: 'Playfair Display', serif; color: #2B2623; font-size: 2.2rem;">Create Account</h2>
                                <p class="text-muted small mb-3 text-uppercase" style="font-size: 0.9rem; letter-spacing: 1px;">Trở thành thành viên để nhận ưu đãi</p>

                                <!-- Khung báo lỗi Register AJAX -->
                                <div id="registerAlert" class="alert alert-danger py-2 px-3 mb-3 border-0 rounded-3 small d-none align-items-center gap-2">
                                    <i class="fa-solid fa-circle-exclamation"></i>
                                    <span id="registerAlertText"></span>
                                </div>

                                @if (!string.IsNullOrEmpty(registerError))
                                {
                                    <div class="alert alert-danger py-2 px-3 mb-3 border-0 rounded-3 small d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-circle-exclamation"></i>
                                        <span>@registerError</span>
                                    </div>
                                }

                                    @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { id = "registerForm" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <div class="mb-3">
                                            <input type="text" name="FullName" value="@(oldRegister != null ? oldRegister.FullName : "")" class="form-control border-0 px-3 shadow-sm bg-white fs-6" placeholder="Họ và tên" required />
                                        </div>
                                        <div class="mb-3">
                                            <input type="email" name="Email" value="@(oldRegister != null ? oldRegister.Email : "")" class="form-control border-0 px-3 shadow-sm bg-white fs-6" placeholder="Địa chỉ Email" required />
                                        </div>
                                        <div class="mb-3">
                                            <input type="tel" name="Phone" value="@(oldRegister != null ? oldRegister.Phone : "")" class="form-control border-0 px-3 shadow-sm bg-white fs-6" placeholder="Số điện thoại" />
                                        </div>
                                        <div class="mb-3">
                                            <input type="password" name="Password" class="form-control border-0 px-3 shadow-sm bg-white fs-6" placeholder="Mật khẩu" required />
                                        </div>
                                        <div class="mb-3">
                                            <input type="password" name="ConfirmPassword" class="form-control border-0 px-3 shadow-sm bg-white fs-6" placeholder="Xác nhận mật khẩu" required />
                                        </div>
                                        <button type="submit" id="btnRegisterSubmit" class="btn w-100 py-3 text-white fw-bold shadow-sm fs-5" style="background-color: #C2A682; border-radius: 8px; letter-spacing: 1px;">TẠO TÀI KHOẢN</button>
                                    }
                                </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Submit Login AJAX
        var loginForm = document.getElementById("loginForm");
        if (loginForm) {
            loginForm.addEventListener("submit", function (e) {
                e.preventDefault();
                var formData = new FormData(loginForm);
                var alertBox = document.getElementById("loginAlert");
                var alertText = document.getElementById("loginAlertText");

                fetch(loginForm.action, {
                    method: "POST",
                    body: formData,
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            window.location.href = data.redirectUrl;
                        } else {
                            if (alertBox && alertText) {
                                alertText.textContent = data.message;
                                alertBox.classList.remove("d-none");
                                alertBox.classList.add("d-flex");
                            }
                        }
                    })
                    .catch(err => console.error("Error Login:", err));
            });
        }

        // Submit Register AJAX
        var registerForm = document.getElementById("registerForm");
        if (registerForm) {
            registerForm.addEventListener("submit", function (e) {
                e.preventDefault();
                var formData = new FormData(registerForm);
                var alertBox = document.getElementById("registerAlert");
                var alertText = document.getElementById("registerAlertText");

                fetch(registerForm.action, {
                    method: "POST",
                    body: formData,
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            window.location.href = data.redirectUrl;
                        } else {
                            if (alertBox && alertText) {
                                alertText.textContent = data.message;
                                alertBox.classList.remove("d-none");
                                alertBox.classList.add("d-flex");
                            }
                        }
                    })
                    .catch(err => console.error("Error Register:", err));
            });
        }
    });
</script>
