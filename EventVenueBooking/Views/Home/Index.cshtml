@model IEnumerable<EventVenueBooking.ViewModels.VenueCardViewModel>

@{
    ViewData["Title"] = "Trang chủ";
}

<div class="hero-wrapper" style="background-image: url('@Url.Content("~/Content/images/bg_landingpage.jpg")');">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 class="display-3 fw-bold mb-3" style="color: var(--primary-brown); line-height: 1.1; letter-spacing: -1px;">
                    THE PERFECT <br />EVENT VENUE
                </h1>
                <p class="lead text-dark fw-bold mb-4" style="max-width: 480px; opacity: 0.9; text-shadow: 0 1px 2px rgba(255,255,255,0.8);">
                    Khám phá không gian tổ chức sự kiện đỉnh cao, tiệc cưới sang trọng và hội thảo chuyên nghiệp với hệ thống đặt sảnh hiện đại.
                </p>
                <div>
                    <a href="#venue-gallery" class="btn btn-brown px-4 py-3 shadow">KHÁM PHÁ NGAY</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container my-5">
    <div id="venue-gallery" class="pt-3">
        <div class="text-center mb-4">
            <h6 class="text-uppercase tracking-wider text-muted fw-bold small">DANH MỤC SỰ KIỆN</h6>
            <h2 class="fw-bold" style="color: var(--primary-brown);">Moments We Created</h2>
        </div>


        <div class="d-flex justify-content-center gap-2 mb-5 flex-wrap">
            <button class="btn btn-brown btn-sm px-4">All Events</button>
            <button class="btn btn-outline-secondary rounded-pill btn-sm px-4">Weddings</button>
            <button class="btn btn-outline-secondary rounded-pill btn-sm px-4">Corporate</button>
            <button class="btn btn-outline-secondary rounded-pill btn-sm px-4">Birthday</button>
            <button class="btn btn-outline-secondary rounded-pill btn-sm px-4">Social</button>
        </div>

        <!-- Bảng danh sách Venue Cards -->
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card venue-card h-100 shadow-sm">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 220px; object-fit: cover;">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge rounded-pill text-bg-warning">@item.TypeName</span>
                                <small class="text-muted"><i class="fa-solid fa-location-dot me-1"></i>@item.Location</small>
                            </div>
                            <h5 class="card-title fw-bold">@item.Name</h5>
                            <p class="card-text text-muted small mb-3">
                                <i class="fa-solid fa-users me-1"></i> Sức chứa: <strong>@item.Capacity người</strong>
                            </p>

                            <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-bold text-danger fs-5">@item.RentalRate.ToString("N0") VNĐ</span>
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">
                                        / @(item.RentalUnit == 0 ? "Giờ" : item.RentalUnit == 1 ? "Buổi" : "Ngày")
                                    </small>
                                </div>
                                <a href="/Venue/Details/@item.VenueId" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                    Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>